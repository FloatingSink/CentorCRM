# Postgres connection string (Neon or any Postgres instance).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js session/CSRF signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Microsoft Entra ID (Azure AD) app registration for SSO — see README.md for
# the full setup walkthrough. Optional for local dev if you're not testing
# sign-in end to end. No trailing slash on ISSUER — Microsoft's discovery
# document's own `issuer` field omits it even though Microsoft's and Auth.js's
# docs both show one; Auth.js validates these as an exact string match, so a
# trailing slash here causes a real (if confusingly-worded) failure.
AUTH_MICROSOFT_ENTRA_ID_ID=replace-with-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-with-client-secret-value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/replace-with-tenant-id/v2.0

# Cloudflare R2 (S3-compatible object storage, docs/decisions.md 2026-08-10).
# Private bucket, accessed only via signed URLs — never make it public.
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=centor-crm

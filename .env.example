# Postgres connection string (Neon or any Postgres instance).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js session/CSRF signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# SMTP relay used to send magic-link sign-in emails (any provider's SMTP
# credentials work: Postmark, SES, Gmail app password, etc). Optional for
# local dev if you're not testing sign-in end to end.
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=CENTOR CRM <no-reply@example.com>

# Cloudflare R2 (S3-compatible object storage, docs/decisions.md 2026-08-10).
# Private bucket, accessed only via signed URLs — never make it public.
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=centor-crm

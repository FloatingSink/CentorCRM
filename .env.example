# Postgres connection string (Neon or any Postgres instance).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js session/CSRF signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# SMTP relay used to send magic-link sign-in emails (any provider's SMTP
# credentials work: Postmark, SES, Gmail app password, etc). Optional for
# local dev if you're not testing sign-in end to end.
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=CENTOR CRM <no-reply@example.com>
